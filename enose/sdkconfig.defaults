# ESP-IDF SDK Configuration Defaults
# ====================================

# WiFi
CONFIG_ESP_WIFI_ENABLED=y

# MQTT
CONFIG_MQTT_PROTOCOL_311=y

# OTA - Partition table dual OTA (ota_0 / ota_1) memakai partitions.csv.
# JANGAN set CONFIG_PARTITION_TABLE_CUSTOM / _FILENAME di sini (esp-idf-sys
# akan mencari file di folder build dan gagal). Tabel dipasang saat flash lewat
# runner espflash: --partition-table partitions.csv (lihat .cargo/config.toml)

# Rollback protection
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# HTTPS/TLS support (required for Azure & MongoDB)
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y
CONFIG_ESP_TLS_USING_MBEDTLS=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y

# Stack sizes (ESP32-S3 has plenty of RAM)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

# System
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000

# Log level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Compiler optimization
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

